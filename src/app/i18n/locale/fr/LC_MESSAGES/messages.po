#. GAME
msgid "Game"
msgstr "Jeu"

#. RESOLUTION
msgid "Resolution:"
msgstr "Résolution :"

#. LANGUAGE
msgid "Language"
msgstr "Langue"

#. THEME
msgid "Theme"
msgstr "Thème"

#. THEME_AUTO
msgid "Auto"
msgstr "Automatique"

#. THEME_LIGHT
msgid "Light"
msgstr "Clair"

#. THEME_DARK
msgid "Dark"
msgstr "Sombre"

#. SEARCH
msgid "Search"
msgstr "Rechercher"

#. SETTING
msgid "Setting"
msgstr "Paramètre"

#. VALUE
msgid "Value"
msgstr "Valeur"

#. LOAD_GAMES
msgid "Load games"
msgstr "Charger les jeux"

#. SHOW_LOGS
msgid "Show logs"
msgstr "Afficher le journal"

#. HIDE_LOGS
msgid "Hide logs"
msgstr "Masquer le journal"

#. LOADING
msgid "Loading…"
msgstr "Chargement…"

#. CPU
msgid "CPU:"
msgstr "CPU :"

#. GPU
msgid "GPU:"
msgstr "GPU :"

#. RAM
msgid "RAM:"
msgstr "RAM :"

#. VRAM
msgid "VRAM:"
msgstr "VRAM :"

#. SIZE_GB
#, python-brace-format
msgid "{size} GB"
msgstr "{size} Go"

#. UNKNOWN
msgid "unknown"
msgstr "inconnue"

#. CHOOSE_CPU
msgid "Choose a processor"
msgstr "Choisir un processeur"

#. CHOOSE_GPU
msgid "Choose a graphics card"
msgstr "Choisir une carte graphique"

#. GAMES_FAILED
#, python-brace-format
msgid "Could not load the game list: {error}"
msgstr "Impossible de charger la liste des jeux : {error}"

#. REQUEST_FAILED
#, python-brace-format
msgid "Could not get data from NVIDIA: {error}"
msgstr "Impossible d’obtenir les données de NVIDIA : {error}"

#. NO_RECOMMENDATION
msgid "No recommendations"
msgstr "Aucune recommandation"

#. RESOLUTION_FALLBACK
#, python-brace-format
msgid "No preset for {chosen}: showing the one for {shown}."
msgstr "Aucun préréglage pour {chosen} : celui de {shown} est affiché."

#. RESOLUTION_BELOW_MIN_SPEC
msgid "Too demanding for this PC: even the lowest settings may stutter at this resolution."
msgstr "Trop exigeant pour ce PC : même avec les paramètres les plus bas, le jeu peut saccader à cette résolution."

#. PERFORMANCE
msgid "Performance"
msgstr "Performances"

#. QUALITY
msgid "Quality"
msgstr "Qualité"

#. PRESET
msgid "preset"
msgstr "préréglage"

#. OPTIMAL_PRESET
msgid "optimal preset"
msgstr "préréglage optimal"

#. BACK_TO_OPTIMAL
msgid "Back to optimal"
msgstr "Revenir à l’optimal"

#. NO_NVIDIA_GPU
msgid "No NVIDIA graphics card found. This app recommends settings for NVIDIA graphics cards only."
msgstr ""
"Aucune carte graphique NVIDIA trouvée. Cette application ne recommande des paramètres que pour les cartes graphiques "
"NVIDIA."

#. UNSUPPORTED_HARDWARE
msgid ""
"GamePreset Peek works only with NVIDIA graphics cards and AMD or Intel processors. Choose your processor and graphics"
" card in the links at the top."
msgstr ""
"GamePreset Peek fonctionne uniquement avec les cartes graphiques NVIDIA et les processeurs AMD ou Intel. Choisissez "
"votre processeur et votre carte graphique avec les liens en haut."

#. CPU_NOT_DETECTED
msgid "Could not detect the processor. Choose yours from the list."
msgstr "Impossible de détecter le processeur. Choisissez le vôtre dans la liste."

#. CPU_REJECTED
msgid "NVIDIA does not know your processor. Choose it from the list."
msgstr "NVIDIA ne connaît pas votre processeur. Choisissez-le dans la liste."

#. GPU_REJECTED
msgid "NVIDIA does not know your graphics card. Choose the closest one from the list."
msgstr "NVIDIA ne connaît pas votre carte graphique. Choisissez la plus proche dans la liste."

#. HARDWARE_FAILED
#, python-brace-format
msgid "Could not detect the hardware: {error}"
msgstr "Impossible de détecter le matériel : {error}"

#. HARDWARE_REJECTED
#, python-brace-format
msgid "NVIDIA does not support this computer: {components}."
msgstr "NVIDIA ne prend pas en charge cet ordinateur : {components}."

#. COMPONENT_CPU
msgid "processor"
msgstr "processeur"

#. COMPONENT_GPU
msgid "graphics card"
msgstr "carte graphique"

#. COMPONENT_MEMORY
msgid "memory"
msgstr "mémoire"

#. COMPONENT_OS
msgid "Windows version"
msgstr "version de Windows"

