#. GAME
msgid "Game"
msgstr "Jeu"

#. RESOLUTION
msgid "Resolution"
msgstr "Résolution"

#. LANGUAGE
msgid "Language"
msgstr "Langue"

#. THEME
msgid "Theme"
msgstr "Thème"

#. THEME_AUTO
msgid "Auto"
msgstr "Automatique"

#. THEME_LIGHT
msgid "Light"
msgstr "Clair"

#. THEME_DARK
msgid "Dark"
msgstr "Sombre"

#. SEARCH
msgid "Search"
msgstr "Rechercher"

#. SETTINGS_SUBTITLE
#, python-brace-format
msgid "{resolution}, target {rate} FPS"
msgstr "{resolution}, objectif {rate} FPS"

#. SETTING
msgid "Setting"
msgstr "Paramètre"

#. VALUE
msgid "Value"
msgstr "Valeur"

#. LOAD_GAMES
msgid "Load games"
msgstr "Charger les jeux"

#. SHOW_SETTINGS
msgid "Show settings"
msgstr "Afficher les paramètres"

#. SHOW_LOGS
msgid "Show logs"
msgstr "Afficher le journal"

#. HIDE_LOGS
msgid "Hide logs"
msgstr "Masquer le journal"

#. CHANGE_GPU
msgid "Change graphics card"
msgstr "Changer de carte graphique"

#. OK
msgid "OK"
msgstr "OK"

#. CANCEL
msgid "Cancel"
msgstr "Annuler"

#. LOADING
msgid "Loading…"
msgstr "Chargement…"

#. GAMES_FAILED
#, python-brace-format
msgid "Could not load the game list: {error}"
msgstr "Impossible de charger la liste des jeux : {error}"

#. REQUEST_FAILED
#, python-brace-format
msgid "Could not get data from NVIDIA: {error}"
msgstr "Impossible d’obtenir les données de NVIDIA : {error}"

#. NO_RECOMMENDATION
msgid "No recommendations"
msgstr "Aucune recommandation"

#. NO_HARDWARE
msgid "Choose a graphics card first."
msgstr "Choisissez d’abord une carte graphique."

#. RESOLUTION_BELOW_MIN_SPEC
msgid "This PC is below the minimum requirements for this resolution: even the lowest settings may stutter."
msgstr ""
"Ce PC est en dessous de la configuration minimale pour cette résolution : même les réglages les plus bas peuvent "
"saccader."

#. PERFORMANCE
msgid "Performance"
msgstr "Performances"

#. QUALITY
msgid "Quality"
msgstr "Qualité"

#. PRESET
msgid "preset"
msgstr "préréglage"

#. OPTIMAL_PRESET
msgid "optimal preset"
msgstr "préréglage optimal"

#. BACK_TO_OPTIMAL
msgid "Back to optimal"
msgstr "Revenir à l’optimal"

#. CURRENT_GPU
#, python-brace-format
msgid "Graphics card: {gpu}"
msgstr "Carte graphique : {gpu}"

#. GPU_NOT_CHOSEN
msgid "No graphics card chosen."
msgstr "Aucune carte graphique choisie."

#. NO_NVIDIA_GPU
msgid "No NVIDIA graphics card found. NVIDIA recommends settings for NVIDIA graphics cards only."
msgstr "Aucune carte graphique NVIDIA trouvée. NVIDIA ne recommande des paramètres que pour les cartes graphiques NVIDIA."

#. HARDWARE_REJECTED
#, python-brace-format
msgid "NVIDIA does not support this computer: {components}."
msgstr "NVIDIA ne prend pas en charge cet ordinateur : {components}."

#. COMPONENT_CPU
msgid "processor"
msgstr "processeur"

#. COMPONENT_GPU
msgid "graphics card"
msgstr "carte graphique"

#. COMPONENT_MEMORY
msgid "memory"
msgstr "mémoire"

#. COMPONENT_OS
msgid "Windows version"
msgstr "version de Windows"

#. CHOOSE_GPU_TITLE
msgid "Graphics card"
msgstr "Carte graphique"

#. CHOOSE_DETECTED_GPU
msgid "Several NVIDIA graphics cards found. Choose the one you play on."
msgstr "Plusieurs cartes graphiques NVIDIA trouvées. Choisissez celle avec laquelle vous jouez."

#. CHOOSE_LISTED_GPU
msgid "NVIDIA does not know your graphics card. Choose the closest one from the list."
msgstr "NVIDIA ne connaît pas votre carte graphique. Choisissez la plus proche dans la liste."

#. CHOOSE_ANY_GPU
msgid "Choose the graphics card to get recommended settings for."
msgstr "Choisissez la carte graphique pour laquelle obtenir les paramètres recommandés."

