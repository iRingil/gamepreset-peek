#. GAME
msgid "Game"
msgstr "Игра"

#. RESOLUTION
msgid "Resolution"
msgstr "Разрешение"

#. LANGUAGE
msgid "Language"
msgstr "Язык"

#. THEME
msgid "Theme"
msgstr "Тема"

#. THEME_AUTO
msgid "Auto"
msgstr "Авто"

#. THEME_LIGHT
msgid "Light"
msgstr "Светлая"

#. THEME_DARK
msgid "Dark"
msgstr "Тёмная"

#. SEARCH
msgid "Search"
msgstr "Поиск"

#. SETTINGS_SUBTITLE
#, python-brace-format
msgid "{resolution}, target {rate} FPS"
msgstr "{resolution}, цель {rate} FPS"

#. SETTING
msgid "Setting"
msgstr "Настройка"

#. VALUE
msgid "Value"
msgstr "Значение"

#. LOAD_GAMES
msgid "Load games"
msgstr "Загрузить игры"

#. SHOW_SETTINGS
msgid "Show settings"
msgstr "Показать настройки"

#. SHOW_LOGS
msgid "Show logs"
msgstr "Показать журнал"

#. HIDE_LOGS
msgid "Hide logs"
msgstr "Скрыть журнал"

#. CHANGE_GPU
msgid "Change graphics card"
msgstr "Сменить видеокарту"

#. OK
msgid "OK"
msgstr "OK"

#. CANCEL
msgid "Cancel"
msgstr "Отмена"

#. LOADING
msgid "Loading…"
msgstr "Загрузка…"

#. GAMES_FAILED
#, python-brace-format
msgid "Could not load the game list: {error}"
msgstr "Не удалось загрузить список игр: {error}"

#. REQUEST_FAILED
#, python-brace-format
msgid "Could not get data from NVIDIA: {error}"
msgstr "Не удалось получить данные от NVIDIA: {error}"

#. NO_RECOMMENDATION
msgid "No recommendations"
msgstr "Нет рекомендаций"

#. NO_HARDWARE
msgid "Choose a graphics card first."
msgstr "Сначала выберите видеокарту."

#. RESOLUTION_BELOW_MIN_SPEC
#, python-brace-format
msgid "{resolution} (below minimum requirements)"
msgstr "{resolution} (ниже минимальных требований)"

#. PERFORMANCE
msgid "Performance"
msgstr "Производительность"

#. QUALITY
msgid "Quality"
msgstr "Качество"

#. PRESET
msgid "preset"
msgstr "пресет"

#. OPTIMAL_PRESET
msgid "optimal preset"
msgstr "оптимальный пресет"

#. BACK_TO_OPTIMAL
msgid "Back to optimal"
msgstr "Вернуть оптимальный"

#. CURRENT_GPU
#, python-brace-format
msgid "Graphics card: {gpu}"
msgstr "Видеокарта: {gpu}"

#. GPU_NOT_CHOSEN
msgid "No graphics card chosen."
msgstr "Видеокарта не выбрана."

#. NO_NVIDIA_GPU
msgid "No NVIDIA graphics card found. NVIDIA recommends settings for NVIDIA graphics cards only."
msgstr "Видеокарта NVIDIA не найдена. NVIDIA рекомендует настройки только для видеокарт NVIDIA."

#. HARDWARE_REJECTED
#, python-brace-format
msgid "NVIDIA does not support this computer: {components}."
msgstr "NVIDIA не поддерживает этот компьютер: {components}."

#. COMPONENT_CPU
msgid "processor"
msgstr "процессор"

#. COMPONENT_GPU
msgid "graphics card"
msgstr "видеокарта"

#. COMPONENT_MEMORY
msgid "memory"
msgstr "память"

#. COMPONENT_OS
msgid "Windows version"
msgstr "версия Windows"

#. CHOOSE_GPU_TITLE
msgid "Graphics card"
msgstr "Видеокарта"

#. CHOOSE_DETECTED_GPU
msgid "Several NVIDIA graphics cards found. Choose the one you play on."
msgstr "Найдено несколько видеокарт NVIDIA. Выберите ту, на которой играете."

#. CHOOSE_LISTED_GPU
msgid "NVIDIA does not know your graphics card. Choose the closest one from the list."
msgstr "NVIDIA не знает вашу видеокарту. Выберите самую похожую из списка."

#. CHOOSE_ANY_GPU
msgid "Choose the graphics card to get recommended settings for."
msgstr "Выберите видеокарту, для которой нужны рекомендуемые настройки."

