#. MY_GAMES
msgid "My games"
msgstr "Мои игры"

#. ALL_GAMES
msgid "All games"
msgstr "Все игры"

#. GAME_FOLDERS
msgid "Where to look for games"
msgstr "Где искать игры"

#. ADD_FOLDER
msgid "Add a folder"
msgstr "Добавить папку"

#. CHANGE_FOLDER
msgid "Change the folder"
msgstr "Изменить папку"

#. REMOVE_FOLDER
msgid "Remove the folder"
msgstr "Убрать папку"

#. FIND_AGAIN
msgid "Search again"
msgstr "Найти заново"

#. CHOOSE_FOLDER
msgid "Choose a folder with games"
msgstr "Выберите папку с играми"

#. NO_GAMES_FOUND
msgid "No games found. Add the folder your games are installed in."
msgstr "Игры не найдены. Добавьте папку, в которую они установлены."

#. FIND_FAILED
#, python-brace-format
msgid "Could not search for games: {error}"
msgstr "Не удалось найти игры: {error}"

#. RESOLUTION
msgid "Resolution:"
msgstr "Разрешение:"

#. LANGUAGE
msgid "Language"
msgstr "Язык"

#. THEME
msgid "Theme"
msgstr "Тема"

#. THEME_AUTO
msgid "Auto"
msgstr "Авто"

#. THEME_LIGHT
msgid "Light"
msgstr "Светлая"

#. THEME_DARK
msgid "Dark"
msgstr "Тёмная"

#. SETTINGS
msgid "Settings"
msgstr "Настройки"

#. AUTO_UPDATE
msgid "Auto-update"
msgstr "Автообновление"

#. AUTO_UPDATE_HINT
msgid "Downloads the latest lists of processors, graphics cards and games once a week."
msgstr "Раз в неделю загружает свежие списки процессоров, видеокарт и игр."

#. SEARCH
msgid "Search"
msgstr "Поиск"

#. SETTING
msgid "Setting"
msgstr "Настройка"

#. VALUE
msgid "Value"
msgstr "Значение"

#. SHOW_LOGS
msgid "Show logs"
msgstr "Показать журнал"

#. HIDE_LOGS
msgid "Hide logs"
msgstr "Скрыть журнал"

#. LOADING
msgid "Loading…"
msgstr "Загрузка…"

#. CPU
msgid "CPU:"
msgstr "Процессор:"

#. GPU
msgid "GPU:"
msgstr "Видеокарта:"

#. RAM
msgid "RAM:"
msgstr "ОЗУ:"

#. VRAM
msgid "VRAM:"
msgstr "Видеопамять:"

#. SIZE_GB
#, python-brace-format
msgid "{size} GB"
msgstr "{size} ГБ"

#. UNKNOWN
msgid "unknown"
msgstr "неизвестно"

#. CHOOSE_CPU
msgid "Choose a processor"
msgstr "Выберите процессор"

#. CHOOSE_GPU
msgid "Choose a graphics card"
msgstr "Выберите видеокарту"

#. REQUEST_FAILED
#, python-brace-format
msgid "Could not get data from NVIDIA: {error}"
msgstr "Не удалось получить данные от NVIDIA: {error}"

#. NO_RECOMMENDATION
msgid "No recommendations"
msgstr "Нет рекомендаций"

#. RESOLUTION_FALLBACK
#, python-brace-format
msgid "No preset for {chosen}: showing the one for {shown}."
msgstr "Нет пресета для {chosen}: показан пресет для {shown}."

#. RESOLUTION_BELOW_MIN_SPEC
msgid "Too demanding for this PC: even the lowest settings may stutter at this resolution."
msgstr "Слишком тяжело для этого ПК: даже на минимальных настройках в этом разрешении возможны подтормаживания."

#. PERFORMANCE
msgid "Performance"
msgstr "Производительность"

#. QUALITY
msgid "Quality"
msgstr "Качество"

#. PRESET
msgid "preset"
msgstr "пресет"

#. OPTIMAL_PRESET
msgid "optimal preset"
msgstr "оптимальный пресет"

#. OPTIMAL
msgid "Optimal"
msgstr "Оптимальный"

#. NO_NVIDIA_GPU
msgid "No NVIDIA graphics card found. This app recommends settings for NVIDIA graphics cards only."
msgstr "Видеокарта NVIDIA не найдена. Эта программа рекомендует настройки только для видеокарт NVIDIA."

#. UNSUPPORTED_HARDWARE
msgid ""
"GamePreset Peek works only with NVIDIA graphics cards and AMD or Intel processors. Choose your processor and graphics"
" card in the links at the top."
msgstr ""
"GamePreset Peek работает только с видеокартами NVIDIA и процессорами AMD или Intel. Выберите свой процессор и "
"видеокарту по ссылкам вверху."

#. CPU_NOT_DETECTED
msgid "Could not detect the processor. Choose yours from the list."
msgstr "Не удалось определить процессор. Выберите свой из списка."

#. CPU_REJECTED
msgid "NVIDIA does not know your processor. Choose it from the list."
msgstr "NVIDIA не знает ваш процессор. Выберите его из списка."

#. GPU_REJECTED
msgid "NVIDIA does not know your graphics card. Choose the closest one from the list."
msgstr "NVIDIA не знает вашу видеокарту. Выберите самую похожую из списка."

#. HARDWARE_FAILED
#, python-brace-format
msgid "Could not detect the hardware: {error}"
msgstr "Не удалось определить оборудование: {error}"

#. HARDWARE_REJECTED
#, python-brace-format
msgid "NVIDIA does not support this computer: {components}."
msgstr "NVIDIA не поддерживает этот компьютер: {components}."

#. COMPONENT_CPU
msgid "processor"
msgstr "процессор"

#. COMPONENT_GPU
msgid "graphics card"
msgstr "видеокарта"

#. COMPONENT_MEMORY
msgid "memory"
msgstr "память"

#. COMPONENT_OS
msgid "Windows version"
msgstr "версия Windows"

