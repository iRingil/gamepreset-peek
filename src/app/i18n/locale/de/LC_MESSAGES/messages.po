#. GAME
msgid "Game"
msgstr "Spiel"

#. RESOLUTION
msgid "Resolution"
msgstr "Auflösung"

#. LANGUAGE
msgid "Language"
msgstr "Sprache"

#. THEME
msgid "Theme"
msgstr "Design"

#. THEME_AUTO
msgid "Auto"
msgstr "Automatisch"

#. THEME_LIGHT
msgid "Light"
msgstr "Hell"

#. THEME_DARK
msgid "Dark"
msgstr "Dunkel"

#. SEARCH
msgid "Search"
msgstr "Suchen"

#. SETTINGS_SUBTITLE
#, python-brace-format
msgid "{resolution}, target {rate} FPS"
msgstr "{resolution}, Ziel {rate} FPS"

#. SETTING
msgid "Setting"
msgstr "Einstellung"

#. VALUE
msgid "Value"
msgstr "Wert"

#. LOAD_GAMES
msgid "Load games"
msgstr "Spiele laden"

#. SHOW_SETTINGS
msgid "Show settings"
msgstr "Einstellungen anzeigen"

#. SHOW_LOGS
msgid "Show logs"
msgstr "Protokoll anzeigen"

#. HIDE_LOGS
msgid "Hide logs"
msgstr "Protokoll ausblenden"

#. CHANGE_GPU
msgid "Change graphics card"
msgstr "Grafikkarte ändern"

#. OK
msgid "OK"
msgstr "OK"

#. CANCEL
msgid "Cancel"
msgstr "Abbrechen"

#. LOADING
msgid "Loading…"
msgstr "Wird geladen…"

#. GAMES_FAILED
#, python-brace-format
msgid "Could not load the game list: {error}"
msgstr "Die Spieleliste konnte nicht geladen werden: {error}"

#. REQUEST_FAILED
#, python-brace-format
msgid "Could not get data from NVIDIA: {error}"
msgstr "Daten von NVIDIA konnten nicht abgerufen werden: {error}"

#. NO_RECOMMENDATION
msgid "No recommendations"
msgstr "Keine Empfehlungen"

#. NO_HARDWARE
msgid "Choose a graphics card first."
msgstr "Wählen Sie zuerst eine Grafikkarte."

#. RESOLUTION_BELOW_MIN_SPEC
#, python-brace-format
msgid "{resolution} (below minimum requirements)"
msgstr "{resolution} (unter den Mindestanforderungen)"

#. PERFORMANCE
msgid "Performance"
msgstr "Leistung"

#. QUALITY
msgid "Quality"
msgstr "Qualität"

#. PRESET
msgid "preset"
msgstr "Voreinstellung"

#. OPTIMAL_PRESET
msgid "optimal preset"
msgstr "optimale Voreinstellung"

#. BACK_TO_OPTIMAL
msgid "Back to optimal"
msgstr "Zurück zu optimal"

#. CURRENT_GPU
#, python-brace-format
msgid "Graphics card: {gpu}"
msgstr "Grafikkarte: {gpu}"

#. GPU_NOT_CHOSEN
msgid "No graphics card chosen."
msgstr "Keine Grafikkarte ausgewählt."

#. NO_NVIDIA_GPU
msgid "No NVIDIA graphics card found. NVIDIA recommends settings for NVIDIA graphics cards only."
msgstr "Keine NVIDIA-Grafikkarte gefunden. NVIDIA empfiehlt Einstellungen nur für NVIDIA-Grafikkarten."

#. HARDWARE_REJECTED
#, python-brace-format
msgid "NVIDIA does not support this computer: {components}."
msgstr "NVIDIA unterstützt diesen Computer nicht: {components}."

#. COMPONENT_CPU
msgid "processor"
msgstr "Prozessor"

#. COMPONENT_GPU
msgid "graphics card"
msgstr "Grafikkarte"

#. COMPONENT_MEMORY
msgid "memory"
msgstr "Arbeitsspeicher"

#. COMPONENT_OS
msgid "Windows version"
msgstr "Windows-Version"

#. CHOOSE_GPU_TITLE
msgid "Graphics card"
msgstr "Grafikkarte"

#. CHOOSE_DETECTED_GPU
msgid "Several NVIDIA graphics cards found. Choose the one you play on."
msgstr "Mehrere NVIDIA-Grafikkarten gefunden. Wählen Sie die, mit der Sie spielen."

#. CHOOSE_LISTED_GPU
msgid "NVIDIA does not know your graphics card. Choose the closest one from the list."
msgstr "NVIDIA kennt Ihre Grafikkarte nicht. Wählen Sie die ähnlichste aus der Liste."

#. CHOOSE_ANY_GPU
msgid "Choose the graphics card to get recommended settings for."
msgstr "Wählen Sie die Grafikkarte, für die Sie empfohlene Einstellungen erhalten möchten."

