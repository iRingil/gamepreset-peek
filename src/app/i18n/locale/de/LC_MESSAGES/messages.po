msgid "{resolution}, target {rate} FPS"
msgstr "{resolution}, Ziel {rate} FPS"

#. SETTING
msgid "Setting"
msgstr "Einstellung"

#. VALUE
msgid "Value"
msgstr "Wert"

#. LOAD_GAMES
msgid "Load games"
msgstr "Spiele laden"

#. SHOW_SETTINGS
msgid "Show settings"
msgstr "Einstellungen anzeigen"

#. SHOW_LOGS
msgid "Show logs"
msgstr "Protokoll anzeigen"

#. HIDE_LOGS
msgid "Hide logs"
msgstr "Protokoll ausblenden"

#. LOADING
msgid "Loading…"
msgstr "Wird geladen…"

