#. MY_GAMES
msgid "My games"
msgstr "Meine Spiele"

#. ALL_GAMES
msgid "All games"
msgstr "Alle Spiele"

#. GAME_FOLDERS
msgid "Where to look for games"
msgstr "Wo nach Spielen gesucht wird"

#. ADD_FOLDER
msgid "Add a folder"
msgstr "Ordner hinzufügen"

#. CHANGE_FOLDER
msgid "Change the folder"
msgstr "Ordner ändern"

#. REMOVE_FOLDER
msgid "Remove the folder"
msgstr "Ordner entfernen"

#. FIND_AGAIN
msgid "Search again"
msgstr "Erneut suchen"

#. FIND_AGAIN_HINT
msgid "Search the folders in the list for installed games again"
msgstr "Die Ordner in der Liste erneut nach installierten Spielen durchsuchen"

#. CHOOSE_FOLDER
msgid "Choose a folder with games"
msgstr "Ordner mit Spielen auswählen"

#. NO_GAMES_FOUND
msgid "No games found. Add the folder your games are installed in."
msgstr "Keine Spiele gefunden. Fügen Sie den Ordner hinzu, in dem Ihre Spiele installiert sind."

#. FIND_FAILED
#, python-brace-format
msgid "Could not search for games: {error}"
msgstr "Spielesuche fehlgeschlagen: {error}"

#. RESOLUTION
msgid "Resolution:"
msgstr "Auflösung:"

#. LANGUAGE
msgid "Language"
msgstr "Sprache"

#. THEME
msgid "Theme"
msgstr "Design"

#. THEME_AUTO
msgid "Auto"
msgstr "Automatisch"

#. THEME_LIGHT
msgid "Light"
msgstr "Hell"

#. THEME_DARK
msgid "Dark"
msgstr "Dunkel"

#. SETTINGS
msgid "Settings"
msgstr "Einstellungen"

#. AUTO_UPDATE
msgid "Auto-update"
msgstr "Automatische Aktualisierung"

#. AUTO_UPDATE_HINT
msgid "Downloads the latest lists of processors, graphics cards and games once a week."
msgstr "Lädt einmal pro Woche die neuesten Listen der Prozessoren, Grafikkarten und Spiele herunter."

#. SEARCH
msgid "Search"
msgstr "Suchen"

#. DETECTED
msgid "Detected"
msgstr "Erkannt"

#. FITS_SCREEN
#, python-brace-format
msgid "Same shape as your screen ({ratio}): fills it with no black bars or stretching."
msgstr "Gleiches Seitenverhältnis wie Ihr Bildschirm ({ratio}): füllt ihn ohne schwarze Balken oder Verzerrung."

#. SETTING
msgid "Setting"
msgstr "Einstellung"

#. VALUE
msgid "Value"
msgstr "Wert"

#. SHOW_LOGS
msgid "Show logs"
msgstr "Protokoll anzeigen"

#. HIDE_LOGS
msgid "Hide logs"
msgstr "Protokoll ausblenden"

#. LOADING
msgid "Loading…"
msgstr "Wird geladen…"

#. CPU
msgid "CPU:"
msgstr "CPU:"

#. GPU
msgid "GPU:"
msgstr "GPU:"

#. RAM
msgid "RAM:"
msgstr "RAM:"

#. VRAM
msgid "VRAM:"
msgstr "VRAM:"

#. SIZE_GB
#, python-brace-format
msgid "{size} GB"
msgstr "{size} GB"

#. UNKNOWN
msgid "unknown"
msgstr "unbekannt"

#. CHOOSE_CPU
msgid "Choose a processor"
msgstr "Prozessor wählen"

#. CHOOSE_GPU
msgid "Choose a graphics card"
msgstr "Grafikkarte wählen"

#. CPU_HINT
msgid "Choose another processor"
msgstr "Einen anderen Prozessor wählen"

#. GPU_HINT
msgid "Choose another graphics card"
msgstr "Eine andere Grafikkarte wählen"

#. RESOLUTION_HINT
msgid "Choose another screen resolution"
msgstr "Eine andere Bildschirmauflösung wählen"

#. REQUEST_FAILED
#, python-brace-format
msgid "Could not get data from NVIDIA: {error}"
msgstr "Daten von NVIDIA konnten nicht abgerufen werden: {error}"

#. SAVE_FAILED
#, python-brace-format
msgid "Could not save the settings: {error}"
msgstr "Die Einstellungen konnten nicht gespeichert werden: {error}"

#. ERROR_NO_CONNECTION
msgid "no connection, check your internet"
msgstr "keine Verbindung, prüfen Sie Ihr Internet"

#. ERROR_NO_ANSWER
msgid "the server is not answering, try again later"
msgstr "der Server antwortet nicht, versuchen Sie es später erneut"

#. ERROR_HTTP
#, python-brace-format
msgid "the server answered with error {status}"
msgstr "der Server antwortete mit Fehler {status}"

#. ERROR_BAD_ANSWER
msgid "the server sent data in an unexpected format"
msgstr "der Server hat Daten in einem unerwarteten Format gesendet"

#. ERROR_UNEXPECTED
msgid "unexpected error, see the logs"
msgstr "unerwarteter Fehler, siehe Protokoll"

#. NO_RECOMMENDATION_TITLE
msgid "No recommendations"
msgstr "Keine Empfehlungen"

#. NO_RECOMMENDATION
msgid "No recommendations (there are none, or your hardware is too weak for this resolution and game)"
msgstr "Keine Empfehlungen (es gibt keine, oder Ihre Hardware ist für diese Auflösung und dieses Spiel zu schwach)"

#. RESOLUTION_FALLBACK
#, python-brace-format
msgid "No preset for {chosen}: showing the one for {shown}."
msgstr "Kein Preset für {chosen}: gezeigt wird das für {shown}."

#. RESOLUTION_BELOW_MIN_SPEC
msgid "Too demanding for this PC: even the lowest settings may stutter at this resolution."
msgstr "Zu anspruchsvoll für diesen PC: selbst mit den niedrigsten Einstellungen kann es bei dieser Auflösung ruckeln."

#. PERFORMANCE
msgid "Performance"
msgstr "Leistung"

#. QUALITY
msgid "Quality"
msgstr "Qualität"

#. PRESET
msgid "preset"
msgstr "Voreinstellung"

#. OPTIMAL_PRESET
msgid "optimal preset"
msgstr "optimale Voreinstellung"

#. OPTIMAL
msgid "Optimal"
msgstr "Optimal"

#. OPTIMAL_HINT
msgid "Go back to the preset NVIDIA recommends"
msgstr "Zurück zur von NVIDIA empfohlenen Voreinstellung"

#. SLIDER_HINT
msgid "Other presets NVIDIA has for this game; the dot marks the recommended one"
msgstr "Weitere Voreinstellungen von NVIDIA für dieses Spiel; der Punkt markiert die empfohlene"

#. CHANGED_HINT
#, python-brace-format
msgid "Differs from the recommended preset ({value})"
msgstr "Weicht von der empfohlenen Voreinstellung ab ({value})"

#. NO_NVIDIA_GPU
msgid "No NVIDIA graphics card found. Choose yours from the list: the app works with NVIDIA cards only."
msgstr "Keine NVIDIA-Grafikkarte gefunden. Wählen Sie Ihre aus der Liste: Die App funktioniert nur mit NVIDIA-Grafikkarten."

#. NOTHING_DETECTED
msgid "Could not detect the processor or an NVIDIA graphics card. Choose both from the lists."
msgstr "Weder der Prozessor noch eine NVIDIA-Grafikkarte wurden erkannt. Wählen Sie beide aus den Listen."

#. CPU_NOT_DETECTED
msgid "Could not detect the processor. Choose yours from the list."
msgstr "Der Prozessor konnte nicht erkannt werden. Wählen Sie Ihren aus der Liste."

#. CPU_REJECTED
msgid "NVIDIA does not know your processor. Choose it from the list."
msgstr "NVIDIA kennt Ihren Prozessor nicht. Wählen Sie ihn aus der Liste."

#. GPU_REJECTED
msgid "NVIDIA does not know your graphics card. Choose the closest one from the list."
msgstr "NVIDIA kennt Ihre Grafikkarte nicht. Wählen Sie die ähnlichste aus der Liste."

#. HARDWARE_FAILED
#, python-brace-format
msgid "Could not detect the hardware: {error}"
msgstr "Die Hardware konnte nicht erkannt werden: {error}"

#. READ_ONLY_FOLDER
#, python-brace-format
msgid ""
"GamePreset Peek can't write to its folder:\n"
"{folder}\n"
"\n"
"It needs to, to keep its lists of games and hardware up to date. Run it as administrator, or install it in your user "
"folder."
msgstr ""
"GamePreset Peek kann nicht in seinen Ordner schreiben:\n"
"{folder}\n"
"\n"
"Das ist nötig, um die Listen der Spiele und der Hardware aktuell zu halten. Starten Sie es als Administrator oder "
"installieren Sie es in Ihren Benutzerordner."

#. RUN_AS_ADMIN
msgid "Run as administrator"
msgstr "Als Administrator ausführen"

#. CLOSE
msgid "Close"
msgstr "Schließen"

#. HARDWARE_REJECTED
#, python-brace-format
msgid "NVIDIA does not support this computer: {components}."
msgstr "NVIDIA unterstützt diesen Computer nicht: {components}."

#. COMPONENT_CPU
msgid "processor"
msgstr "Prozessor"

#. COMPONENT_GPU
msgid "graphics card"
msgstr "Grafikkarte"

#. COMPONENT_MEMORY
msgid "memory"
msgstr "Arbeitsspeicher"

#. COMPONENT_OS
msgid "Windows version"
msgstr "Windows-Version"

