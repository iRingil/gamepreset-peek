msgstr "Tema"

#. THEME_AUTO
msgid "Auto"
msgstr "Automático"

#. THEME_LIGHT
msgid "Light"
msgstr "Claro"

#. THEME_DARK
msgid "Dark"
msgstr "Oscuro"

#. SETTINGS
msgid "Settings"
msgstr "Ajustes"

#. AUTO_UPDATE
msgid "Auto-update"
msgstr "Actualización automática"

#. AUTO_UPDATE_HINT
msgid "Downloads the latest lists of processors, graphics cards and games once a week."
msgstr "Descarga una vez por semana las listas más recientes de procesadores, tarjetas gráficas y juegos."

#. SEARCH
msgid "Search"
msgstr "Buscar"

#. DETECTED
msgid "Detected"
msgstr "Detectado"

#. SETTING
msgid "Setting"
msgstr "Ajuste"

#. VALUE
msgid "Value"
msgstr "Valor"

#. SHOW_LOGS
msgid "Show logs"
msgstr "Mostrar registro"

#. HIDE_LOGS
msgid "Hide logs"
msgstr "Ocultar registro"

#. LOADING
msgid "Loading…"
msgstr "Cargando…"

#. CPU
msgid "CPU:"
msgstr "CPU:"

#. GPU
msgid "GPU:"
msgstr "GPU:"

#. RAM
msgid "RAM:"
msgstr "RAM:"

#. VRAM
msgid "VRAM:"
msgstr "VRAM:"

#. SIZE_GB
#, python-brace-format
msgid "{size} GB"
msgstr "{size} GB"

#. UNKNOWN
msgid "unknown"
msgstr "desconocida"

#. CHOOSE_CPU
msgid "Choose a processor"
msgstr "Elegir un procesador"

#. CHOOSE_GPU
msgid "Choose a graphics card"
msgstr "Elegir una tarjeta gráfica"

#. REQUEST_FAILED
#, python-brace-format
msgid "Could not get data from NVIDIA: {error}"
msgstr "No se pudieron obtener los datos de NVIDIA: {error}"

#. NO_RECOMMENDATION
msgid "No recommendations"
msgstr "Sin recomendaciones"

#. RESOLUTION_FALLBACK
#, python-brace-format
msgid "No preset for {chosen}: showing the one for {shown}."
msgstr "No hay preajuste para {chosen}: se muestra el de {shown}."

#. RESOLUTION_BELOW_MIN_SPEC
msgid "Too demanding for this PC: even the lowest settings may stutter at this resolution."
msgstr "Demasiado exigente para este PC: incluso con los ajustes más bajos, el juego puede ir a tirones a esta resolución."

#. PERFORMANCE
msgid "Performance"
msgstr "Rendimiento"

#. QUALITY
msgid "Quality"
msgstr "Calidad"

#. PRESET
msgid "preset"
msgstr "preajuste"

#. OPTIMAL_PRESET
msgid "optimal preset"
msgstr "preajuste óptimo"

#. OPTIMAL
msgid "Optimal"
msgstr "Óptimo"

#. NO_NVIDIA_GPU
msgid "No NVIDIA graphics card found. This app recommends settings for NVIDIA graphics cards only."
msgstr "No se encontró ninguna tarjeta gráfica NVIDIA. Esta aplicación solo recomienda ajustes para tarjetas gráficas NVIDIA."

#. UNSUPPORTED_HARDWARE
msgid ""
"GamePreset Peek works only with NVIDIA graphics cards and AMD or Intel processors. Choose your processor and graphics"
" card in the links at the top."
msgstr ""
"GamePreset Peek solo funciona con tarjetas gráficas NVIDIA y procesadores AMD o Intel. Elija su procesador y su "
"tarjeta gráfica en los enlaces de arriba."

#. CPU_NOT_DETECTED
msgid "Could not detect the processor. Choose yours from the list."
msgstr "No se pudo detectar el procesador. Elija el suyo de la lista."

#. CPU_REJECTED
msgid "NVIDIA does not know your processor. Choose it from the list."
msgstr "NVIDIA no conoce su procesador. Elíjalo de la lista."

#. GPU_REJECTED
msgid "NVIDIA does not know your graphics card. Choose the closest one from the list."
msgstr "NVIDIA no conoce su tarjeta gráfica. Elija la más parecida de la lista."

#. HARDWARE_FAILED
#, python-brace-format
msgid "Could not detect the hardware: {error}"
msgstr "No se pudo detectar el hardware: {error}"

#. HARDWARE_REJECTED
#, python-brace-format
msgid "NVIDIA does not support this computer: {components}."
msgstr "NVIDIA no es compatible con este equipo: {components}."

#. COMPONENT_CPU
msgid "processor"
msgstr "procesador"

#. COMPONENT_GPU
msgid "graphics card"
msgstr "tarjeta gráfica"

#. COMPONENT_MEMORY
msgid "memory"
msgstr "memoria"

#. COMPONENT_OS
msgid "Windows version"
msgstr "versión de Windows"

