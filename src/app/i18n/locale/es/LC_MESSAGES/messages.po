#. MY_GAMES
msgid "My games"
msgstr "Mis juegos"

#. ALL_GAMES
msgid "All games"
msgstr "Todos los juegos"

#. GAME_FOLDERS
msgid "Where to look for games"
msgstr "Dónde buscar juegos"

#. ADD_FOLDER
msgid "Add a folder"
msgstr "Añadir una carpeta"

#. CHANGE_FOLDER
msgid "Change the folder"
msgstr "Cambiar la carpeta"

#. REMOVE_FOLDER
msgid "Remove the folder"
msgstr "Quitar la carpeta"

#. FIND_AGAIN
msgid "Search again"
msgstr "Buscar de nuevo"

#. FIND_AGAIN_HINT
msgid "Search the folders in the list for installed games again"
msgstr "Volver a buscar juegos instalados en las carpetas de la lista"

#. CHOOSE_FOLDER
msgid "Choose a folder with games"
msgstr "Elija una carpeta con juegos"

#. NO_GAMES_FOUND
msgid "No games found. Add the folder your games are installed in."
msgstr "No se encontraron juegos. Añada la carpeta donde están instalados."

#. FIND_FAILED
#, python-brace-format
msgid "Could not search for games: {error}"
msgstr "No se pudieron buscar los juegos: {error}"

#. RESOLUTION
msgid "Resolution:"
msgstr "Resolución:"

#. LANGUAGE
msgid "Language"
msgstr "Idioma"

#. THEME
msgid "Theme"
msgstr "Tema"

#. THEME_AUTO
msgid "Auto"
msgstr "Automático"

#. THEME_LIGHT
msgid "Light"
msgstr "Claro"

#. THEME_DARK
msgid "Dark"
msgstr "Oscuro"

#. SETTINGS
msgid "Settings"
msgstr "Ajustes"

#. AUTO_UPDATE
msgid "Auto-update"
msgstr "Actualización automática"

#. AUTO_UPDATE_HINT
msgid "Downloads the latest lists of processors, graphics cards and games once a week."
msgstr "Descarga una vez por semana las listas más recientes de procesadores, tarjetas gráficas y juegos."

#. SEARCH
msgid "Search"
msgstr "Buscar"

#. DETECTED
msgid "Detected"
msgstr "Detectado"

#. FITS_SCREEN
#, python-brace-format
msgid "Same shape as your screen ({ratio}): fills it with no black bars or stretching."
msgstr "Misma proporción que su pantalla ({ratio}): la llena sin barras negras ni estiramiento."

#. SETTING
msgid "Setting"
msgstr "Ajuste"

#. VALUE
msgid "Value"
msgstr "Valor"

#. SHOW_LOGS
msgid "Show logs"
msgstr "Mostrar registro"

#. HIDE_LOGS
msgid "Hide logs"
msgstr "Ocultar registro"

#. LOADING
msgid "Loading…"
msgstr "Cargando…"

#. CPU
msgid "CPU:"
msgstr "CPU:"

#. GPU
msgid "GPU:"
msgstr "GPU:"

#. RAM
msgid "RAM:"
msgstr "RAM:"

#. VRAM
msgid "VRAM:"
msgstr "VRAM:"

#. SIZE_GB
#, python-brace-format
msgid "{size} GB"
msgstr "{size} GB"

#. UNKNOWN
msgid "unknown"
msgstr "desconocida"

#. CHOOSE_CPU
msgid "Choose a processor"
msgstr "Elegir un procesador"

#. CHOOSE_GPU
msgid "Choose a graphics card"
msgstr "Elegir una tarjeta gráfica"

#. CPU_HINT
msgid "Choose another processor"
msgstr "Elegir otro procesador"

#. GPU_HINT
msgid "Choose another graphics card"
msgstr "Elegir otra tarjeta gráfica"

#. RESOLUTION_HINT
msgid "Choose another screen resolution"
msgstr "Elegir otra resolución de pantalla"

#. REQUEST_FAILED
#, python-brace-format
msgid "Could not get data from NVIDIA: {error}"
msgstr "No se pudieron obtener los datos de NVIDIA: {error}"

#. SAVE_FAILED
#, python-brace-format
msgid "Could not save the settings: {error}"
msgstr "No se pudo guardar la configuración: {error}"

#. ERROR_NO_CONNECTION
msgid "no connection, check your internet"
msgstr "sin conexión, revise su acceso a internet"

#. ERROR_NO_ANSWER
msgid "the server is not answering, try again later"
msgstr "el servidor no responde, inténtelo más tarde"

#. ERROR_HTTP
#, python-brace-format
msgid "the server answered with error {status}"
msgstr "el servidor respondió con el error {status}"

#. ERROR_BAD_ANSWER
msgid "the server sent data in an unexpected format"
msgstr "el servidor envió datos en un formato inesperado"

#. ERROR_UNEXPECTED
msgid "unexpected error, see the logs"
msgstr "error inesperado, consulte el registro"

#. NO_RECOMMENDATION_TITLE
msgid "No recommendations"
msgstr "No hay recomendaciones"

#. NO_RECOMMENDATION
msgid "No recommendations (there are none, or your hardware is too weak for this resolution and game)"
msgstr "No hay recomendaciones (no existen, o su equipo es demasiado débil para esta resolución y este juego)"

#. RESOLUTION_FALLBACK
#, python-brace-format
msgid "No preset for {chosen}: showing the one for {shown}."
msgstr "No hay preajuste para {chosen}: se muestra el de {shown}."

#. RESOLUTION_BELOW_MIN_SPEC
msgid "Too demanding for this PC: even the lowest settings may stutter at this resolution."
msgstr "Demasiado exigente para este PC: incluso con los ajustes más bajos, el juego puede ir a tirones a esta resolución."

#. PERFORMANCE
msgid "Performance"
msgstr "Rendimiento"

#. QUALITY
msgid "Quality"
msgstr "Calidad"

#. PRESET
msgid "preset"
msgstr "preajuste"

#. OPTIMAL_PRESET
msgid "optimal preset"
msgstr "preajuste óptimo"

#. OPTIMAL
msgid "Optimal"
msgstr "Óptimo"

#. OPTIMAL_HINT
msgid "Go back to the preset NVIDIA recommends"
msgstr "Volver al preajuste que recomienda NVIDIA"

#. SLIDER_HINT
msgid "Other presets NVIDIA has for this game; the dot marks the recommended one"
msgstr "Otros preajustes de NVIDIA para este juego; el punto marca el recomendado"

#. CHANGED_HINT
#, python-brace-format
msgid "Differs from the recommended preset ({value})"
msgstr "Difiere del preajuste recomendado ({value})"

#. NO_NVIDIA_GPU
msgid "No NVIDIA graphics card found. This app recommends settings for NVIDIA graphics cards only."
msgstr "No se encontró ninguna tarjeta gráfica NVIDIA. Esta aplicación solo recomienda ajustes para tarjetas gráficas NVIDIA."

#. UNSUPPORTED_HARDWARE
msgid ""
"GamePreset Peek works only with NVIDIA graphics cards and AMD or Intel processors. Choose your processor and graphics"
" card in the links at the top."
msgstr ""
"GamePreset Peek solo funciona con tarjetas gráficas NVIDIA y procesadores AMD o Intel. Elija su procesador y su "
"tarjeta gráfica en los enlaces de arriba."

#. CPU_NOT_DETECTED
msgid "Could not detect the processor. Choose yours from the list."
msgstr "No se pudo detectar el procesador. Elija el suyo de la lista."

#. CPU_REJECTED
msgid "NVIDIA does not know your processor. Choose it from the list."
msgstr "NVIDIA no conoce su procesador. Elíjalo de la lista."

#. GPU_REJECTED
msgid "NVIDIA does not know your graphics card. Choose the closest one from the list."
msgstr "NVIDIA no conoce su tarjeta gráfica. Elija la más parecida de la lista."

#. HARDWARE_FAILED
#, python-brace-format
msgid "Could not detect the hardware: {error}"
msgstr "No se pudo detectar el hardware: {error}"

#. HARDWARE_REJECTED
#, python-brace-format
msgid "NVIDIA does not support this computer: {components}."
msgstr "NVIDIA no es compatible con este equipo: {components}."

#. COMPONENT_CPU
msgid "processor"
msgstr "procesador"

#. COMPONENT_GPU
msgid "graphics card"
msgstr "tarjeta gráfica"

#. COMPONENT_MEMORY
msgid "memory"
msgstr "memoria"

#. COMPONENT_OS
msgid "Windows version"
msgstr "versión de Windows"

