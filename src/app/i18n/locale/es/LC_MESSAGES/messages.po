#. MY_GAMES
msgid "My games"
msgstr "Mis juegos"

#. ALL_GAMES
msgid "All games"
msgstr "Todos los juegos"

#. GAME_FOLDERS
msgid "Where to look for games"
msgstr "Dónde buscar juegos"

#. ADD_FOLDER
msgid "Add a folder"
msgstr "Añadir una carpeta"

#. CHANGE_FOLDER
msgid "Change the folder"
msgstr "Cambiar la carpeta"

#. REMOVE_FOLDER
msgid "Remove the folder"
msgstr "Quitar la carpeta"

#. FIND_AGAIN
msgid "Search again"
msgstr "Buscar de nuevo"

#. CHOOSE_FOLDER
msgid "Choose a folder with games"
msgstr "Elija una carpeta con juegos"

#. NO_GAMES_FOUND
msgid "No games found. Add the folder your games are installed in."
msgstr "No se encontraron juegos. Añada la carpeta donde están instalados."

#. FIND_FAILED
#, python-brace-format
msgid "Could not search for games: {error}"
msgstr "No se pudieron buscar los juegos: {error}"

