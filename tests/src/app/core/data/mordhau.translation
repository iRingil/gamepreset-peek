  <language name="ru_RU" translation="">
    <setting name="Ambient Occlusion" translation="Затенение фонового освещения">
      <value name="Off" translation="Выкл."/>
      <value name="On" translation="Вкл."/>
    </setting>
    <setting name="Anti-aliasing" translation="Сглаживание">
      <value name="Off" translation="Выкл."/>
      <value name="FXAA" translation="FXAA"/>
      <value name="Temporal AA" translation="Временное сглаживание"/>
    </setting>
    <setting name="Character Cloth" translation="Физика ткани">
      <value name="No Cloth" translation="Никто"/>
      <value name="Only Self" translation="Только игрок"/>
      <value name="All Cloth" translation="Все"/>
    </setting>
    <setting name="Character Quality" translation="Качество прорисовки персонажей">
      <value name="Low" translation="Низкое"/>
      <value name="Medium" translation="Среднее"/>
      <value name="High" translation="Высокое"/>
    </setting>
    <setting name="Display Mode" translation="Экранный режим">
      <value name="Full-screen" translation="Полный экран"/>
      <value name="Windowed Borderless" translation="В окне без рамки"/>
      <value name="Windowed" translation="В окне"/>
    </setting>
    <setting name="Effects Quality" translation="Качество эффектов">
      <value name="Low" translation="Низкое"/>
      <value name="Medium" translation="Среднее"/>
      <value name="High" translation="Высокое"/>
      <value name="Ultra" translation="Самое высокое"/>
    </setting>
    <setting name="Foliage Density" translation="Плотность растительности">
      <value name="Low" translation="Низкая"/>
      <value name="Medium" translation="Средняя"/>
      <value name="High" translation="Высокая"/>
      <value name="Ultra" translation="Ультра"/>
    </setting>
    <setting name="Indirect Shadows" translation="Вторичные тени">
      <value name="Off" translation="Выкл."/>
      <value name="On" translation="Вкл."/>
    </setting>
    <setting name="Post-Processing" translation="Постобработка">
      <value name="Low" translation="Низко"/>
      <value name="Medium" translation="Средне"/>
      <value name="High" translation="Высоко"/>
      <value name="Ultra" translation="Ультра"/>
    </setting>
    <setting name="Ragdoll Quality" translation="Качество ragdoll-анимации">
      <value name="Low" translation="Низкое"/>
      <value name="Medium" translation="Среднее"/>
      <value name="High" translation="Высокое"/>
    </setting>
    <setting name="Reflex" translation="Reflex">
      <value name="Disabled" translation="Выключено"/>
      <value name="Enabled" translation="Включено"/>
      <value name="Enabled+Boost" translation="Включено + ускорение"/>
    </setting>
    <setting name="Resolution" translation="Разрешение"/>
    <setting name="Resolution Scale" translation="Масштабирование разрешения"/>
    <setting name="Screen Space Reflections" translation="Отражения объектов на экране">
      <value name="Off" translation="Выкл."/>
      <value name="Low" translation="Низко"/>
      <value name="High" translation="Высоко"/>
      <value name="Ultra" translation="Ультра"/>
    </setting>
    <setting name="Shadow Quality" translation="Качество теней">
      <value name="Low" translation="Низкое"/>
      <value name="High" translation="Высокое"/>
      <value name="Ultra" translation="Самое высокое"/>
    </setting>
    <setting name="Texture Quality" translation="Качество текстуры">
      <value name="Low" translation="Низкое"/>
      <value name="Medium" translation="Среднее"/>
      <value name="High" translation="Высокое"/>
      <value name="Ultra" translation="Самое высокое"/>
    </setting>
    <setting name="VSync" translation="Вертикальная синхронизация">
      <value name="Off" translation="Выкл."/>
      <value name="On" translation="Вкл."/>
    </setting>
    <setting name="Vertical Sync" translation="Вертикальная синхронизация">
      <value name="Use the 3D Application Setting" translation="Использовать настройку 3D-приложения"/>
      <value name="Off" translation="Выкл."/>
      <value name="On" translation="Вкл."/>
      <value name="Force On (Interval 2)" translation="Включить (Интервал 2)"/>
      <value name="Adaptive" translation="Адаптивный"/>
      <value name="Adaptive (Half Refresh Rate)" translation="Адаптивный (половина частоты обновления)"/>
      <value name="On (Smooth)" translation="Вкл. (плавная)"/>
      <value name="G-SYNC" translation="G-SYNC"/>
      <value name="G-SYNC Not Supported" translation="G-SYNC не поддерживается"/>
      <value name="Fast" translation="Быстрая"/>
    </setting>
    <setting name="View Distance" translation="Дальность видимости">
      <value name="Low" translation="Низкая"/>
      <value name="Medium" translation="Средняя"/>
      <value name="High" translation="Высокая"/>
      <value name="Ultra" translation="Самая высокая"/>
