<?xml version="1.0" encoding="UTF-8"?>
<game name="mordhau">
  <language name="ar_AE" translation="">
    <setting name="Ambient Occlusion" translation="إطباق محيطي">
      <value name="Off" translation="إيقاف تشغيل"/>
      <value name="On" translation="تشغيل"/>
    </setting>
    <setting name="Anti-aliasing" translation="منع الترادف">
      <value name="Off" translation="إيقاف تشغيل"/>
      <value name="FXAA" translation="FXAA"/>
      <value name="Temporal AA" translation="AA مؤقت"/>
    </setting>
    <setting name="Character Cloth" translation="ملابس الشخصية">
      <value name="No Cloth" translation="بلا ملابس"/>
      <value name="Only Self" translation="ذاتي فقط"/>
      <value name="All Cloth" translation="كل الملابس"/>
    </setting>
    <setting name="Character Quality" translation="جودة الشخصية">
      <value name="Low" translation="منخفض"/>
      <value name="Medium" translation="متوسط"/>
      <value name="High" translation="مرتفع"/>
    </setting>
    <setting name="Display Mode" translation="وضع العرض">
      <value name="Full-screen" translation="شاشة كاملة"/>
      <value name="Windowed Borderless" translation="نافذة بلا حدود"/>
      <value name="Windowed" translation="مزود بإطارات"/>
    </setting>
    <setting name="Effects Quality" translation="جودة التأثيرات">
      <value name="Low" translation="منخفض"/>
      <value name="Medium" translation="متوسط"/>
      <value name="High" translation="مرتفع"/>
      <value name="Ultra" translation="فائق"/>
    </setting>
    <setting name="Foliage Density" translation="كثافة أوراق الشجر">
      <value name="Low" translation="منخفض"/>
      <value name="Medium" translation="متوسط"/>
      <value name="High" translation="مرتفع"/>
      <value name="Ultra" translation="ألترا"/>
    </setting>
    <setting name="Indirect Shadows" translation="ظلال غير مباشرة">
      <value name="Off" translation="إيقاف"/>
      <value name="On" translation="تشغيل"/>
    </setting>
    <setting name="Post-Processing" translation="معالجة لاحقة">
      <value name="Low" translation="منخفض"/>
      <value name="Medium" translation="متوسط"/>
      <value name="High" translation="مرتفع"/>
      <value name="Ultra" translation="فائق"/>
    </setting>
    <setting name="Ragdoll Quality" translation="جودة Ragdoll">
      <value name="Low" translation="منخفض"/>
      <value name="Medium" translation="متوسط"/>
      <value name="High" translation="مرتفع"/>
    </setting>
    <setting name="Reflex" translation="Reflex">
      <value name="Disabled" translation="تعطيل"/>
      <value name="Enabled" translation="تمكين"/>
      <value name="Enabled+Boost" translation="تمكين + تعزيز"/>
    </setting>
    <setting name="Resolution" translation="الدقة"/>
    <setting name="Resolution Scale" translation="معيار الدقة"/>
    <setting name="Screen Space Reflections" translation="انعكاسات مساحة الشاشة">
      <value name="Off" translation="إيقاف التشغيل"/>
      <value name="Low" translation="منخفض"/>
      <value name="High" translation="مرتفع"/>
      <value name="Ultra" translation="ألترا"/>
    </setting>
    <setting name="Shadow Quality" translation="جودة الظل">
      <value name="Low" translation="منخفض"/>
      <value name="High" translation="مرتفع"/>
      <value name="Ultra" translation="فائق"/>
    </setting>
    <setting name="Texture Quality" translation="جودة مواد الصور">
      <value name="Low" translation="منخفض"/>
      <value name="Medium" translation="متوسط"/>
      <value name="High" translation="مرتفع"/>
      <value name="Ultra" translation="فائق"/>
    </setting>
    <setting name="VSync" translation="VSync">
      <value name="Off" translation="إيقاف تشغيل"/>
      <value name="On" translation="تشغيل"/>
    </setting>
    <setting name="Vertical Sync" translation="مزامنة رأسية">
      <value name="Use the 3D Application Setting" translation="استخدام إعداد التطبيق ثلاثي الأبعاد"/>
      <value name="Off" translation="إيقاف تشغيل"/>
      <value name="On" translation="تشغيل"/>
      <value name="Force On (Interval 2)" translation="تشغيل إجباري (فاصل 2)"/>
      <value name="Adaptive" translation="مهايئ"/>
      <value name="Adaptive (Half Refresh Rate)" translation="متكيف (معدل تحديث نصفي)"/>
      <value name="On (Smooth)" translation="تشغيل (ناعم)"/>
      <value name="G-SYNC" translation="G-SYNC"/>
      <value name="G-SYNC Not Supported" translation="G-SYNC غير مدعم"/>
      <value name="Fast" translation="سريع"/>
    </setting>
    <setting name="View Distance" translation="عرض المسافة">
      <value name="Low" translation="منخفض"/>
      <value name="Medium" translation="متوسط"/>
      <value name="High" translation="مرتفع"/>
      <value name="Ultra" translation="فائق"/>
    </setting>
  </language>
